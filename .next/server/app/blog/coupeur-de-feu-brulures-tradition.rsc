e:["$","ul",null,{"className":"text-stone-600 space-y-3","children":[["$","li",null,{"children":[["$","strong",null,{"children":"Soulagement immediat"}]," : La douleur diminue souvent en quelques minutes, parfois instantanement."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Reduction de l'inflammation"}]," : Les rougeurs s'attenuent plus rapidement."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Cicatrisation acceleree"}]," : Les brulures guerissent souvent sans laisser de traces."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Prevention des cloques"}]," : Si l'intervention est rapide, les cloques peuvent ne pas apparaitre."]}]]}]
f:["$","p",null,{"className":"text-stone-600 leading-relaxed","children":"Le coupeur de feu agit sur tous types de brulures : thermiques (flamme, eau bouillante, huile), chimiques, coups de soleil, et meme les brulures liees a la radiotherapie."}]
10:["$","h2",null,{"className":"text-2xl font-serif font-bold text-stone-900 mt-12 mb-4","children":"Reconnaissance hospitaliere"}]
11:["$","p",null,{"className":"text-stone-600 leading-relaxed","children":"Fait remarquable : plusieurs centres hospitaliers francais, notamment des services de grands brules et de radiotherapie, collaborent avec des coupeurs de feu. Le CHU de Grenoble, le Centre Leon Berard a Lyon, et d'autres etablissements ont integre cette pratique dans leur prise en charge."}]
12:["$","p",null,{"className":"text-stone-600 leading-relaxed","children":"Les soignants, d'abord sceptiques, ont constate des resultats trop frequents pour etre ignores. Ils orientent regulierement leurs patients vers des coupeurs de feu, particulierement pour les brulures liees aux traitements contre le cancer."}]
13:["$","h2",null,{"className":"text-2xl font-serif font-bold text-stone-900 mt-12 mb-4","children":"Couper le feu a distance"}]
14:["$","p",null,{"className":"text-stone-600 leading-relaxed","children":"Contrairement a ce qu'on pourrait penser, le coupeur de feu n'a pas besoin d'etre physiquement present. Le soin a distance fonctionne tout aussi bien, ce qui permet d'intervenir rapidement apres une brulure, meme a des centaines de kilometres."}]
15:["$","p",null,{"className":"text-stone-600 leading-relaxed","children":"Jean-Francois pratique le \"coupage de feu\" a distance depuis de nombreuses annees. Un simple appel ou l'envoi d'une photo permet d'intervenir immediatement."}]
16:["$","h2",null,{"className":"text-2xl font-serif font-bold text-stone-900 mt-12 mb-4","children":"Que faire en cas de brulure ?"}]
17:["$","ol",null,{"className":"text-stone-600 space-y-3","children":[["$","li",null,{"children":[["$","strong",null,{"children":"Refroidir immediatement"}]," : Passez la brulure sous l'eau froide (pas glacee) pendant 10-15 minutes."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Evaluer la gravite"}]," : En cas de brulure grave ou etendue, appelez le 15 ou rendez-vous aux urgences."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Contacter un coupeur de feu"}]," : Plus l'intervention est rapide, meilleurs sont les resultats."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Ne pas percer les cloques"}]," : Elles protegent la peau en cours de cicatrisation."]}]]}]
