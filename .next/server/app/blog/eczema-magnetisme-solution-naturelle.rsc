11:["$","blockquote",null,{"className":"bg-teal-50 border-l-4 border-teal-500 p-6 rounded-r-xl not-italic","children":[["$","p",null,{"className":"text-stone-700 mb-4","children":"\"Je souffrais d'eczema aux mains depuis 10 ans. Les cremes ne faisaient plus effet. Apres 3 seances avec Jean-Francois, mes mains ont retrouve un aspect presque normal. Je n'ai plus de poussees depuis 6 mois.\""}],["$","footer",null,{"className":"text-teal-600 font-medium","children":"Sophie, institutrice"}]]}]
