:"}],["$","ul",null,{"children":[["$","li",null,{"children":[["$","strong",null,{"children":"Apaisement des demangeaisons"}]," - L'energie transmise calme les terminaisons nerveuses irritees"]}],["$","li",null,{"children":[["$","strong",null,{"children":"Reduction de l'inflammation"}]," - Le magnetisme favorise la circulation energetique et sanguine"]}],"$Le","$Lf"]}],"$L10","$L11","$L12","$L13","$L14","$L15","$L16","$L17","$L18","$L19","$L1a","$L1b"]}]}],"$L1c"]}]}],null,"$L1d"]}]
