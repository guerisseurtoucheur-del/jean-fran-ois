2:T24eb,{"@context":"https://schema.org","@graph":[{"@type":"LocalBusiness","@id":"https://www.jean-francois-magnetiseur-guerisseur.com/#business","name":"Jean-Francois Magnetiseur Guerisseur","description":"Magnetiseur guerisseur specialise dans les soins energetiques a distance sur photo. Coupeur de feu, traitement du zona, eczema et douleurs chroniques. Intervention partout en France depuis plus de 20 ans.","url":"https://www.jean-francois-magnetiseur-guerisseur.com","telephone":"+33955554462","email":"guerisseurtoucheur@gmail.com","image":"https://www.jean-francois-magnetiseur-guerisseur.com/logo.png","logo":"https://www.jean-francois-magnetiseur-guerisseur.com/logo.png","priceRange":"35EUR - 120EUR","currenciesAccepted":"EUR","paymentAccepted":"PayPal, Carte bancaire","foundingDate":"2004","slogan":"Le Souffle sans frontieres","address":{"@type":"PostalAddress","streetAddress":"Alencon","addressLocality":"Alencon","postalCode":"61000","addressRegion":"Normandie","addressCountry":"FR"},"geo":{"@type":"GeoCoordinates","latitude":48.4333,"longitude":0.0833},"areaServed":[{"@type":"Country","name":"France"},{"@type":"City","name":"Paris"},{"@type":"City","name":"Lyon"},{"@type":"City","name":"Marseille"},{"@type":"City","name":"Bordeaux"},{"@type":"City","name":"Lille"},{"@type":"City","name":"Toulouse"},{"@type":"City","name":"Nantes"},{"@type":"City","name":"Strasbourg"},{"@type":"City","name":"Nice"},{"@type":"City","name":"Montpellier"}],"hasOfferCatalog":{"@type":"OfferCatalog","name":"Soins energetiques a distance","itemListElement":[{"@type":"Offer","@id":"https://www.jean-francois-magnetiseur-guerisseur.com/#offer-ponctuel","name":"Soin Ponctuel","description":"1 seance de magnetisme a distance sur photo","price":"35","priceCurrency":"EUR","availability":"https://schema.org/InStock"},{"@type":"Offer","@id":"https://www.jean-francois-magnetiseur-guerisseur.com/#offer-complet","name":"Soin Complet","description":"2 seances de magnetisme sur 48h - Formule recommandee","price":"55","priceCurrency":"EUR","availability":"https://schema.org/InStock"},{"@type":"Offer","@id":"https://www.jean-francois-magnetiseur-guerisseur.com/#offer-suivi","name":"Forfait Suivi","description":"5 seances sur 2 semaines pour cas chroniques ou complexes","price":"120","priceCurrency":"EUR","availability":"https://schema.org/InStock"}]},"potentialAction":{"@type":"CommunicateAction","name":"Appeler Jean-Francois","target":"tel:+33955554462","description":"Contactez Jean-Francois directement par telephone"},"sameAs":["https://maps.app.goo.gl/7T8BscaocjerZRNWA"]},{"@type":"Person","@id":"https://www.jean-francois-magnetiseur-guerisseur.com/#person","name":"Jean-Francois","givenName":"Jean-Francois","jobTitle":"Magnetiseur Guerisseur","description":"Magnetiseur guerisseur experimente depuis plus de 20 ans, specialise dans les soins energetiques a distance sur photo. Coupeur de feu reconnu, je traite zona, brulures, eczema et douleurs dans toute la France.","knowsAbout":["Magnetisme","Guerisseur traditionnel","Coupeur de feu","Barreur de feu","Soin energetique","Traitement du zona","Traitement de l'eczema","Soulagement des brulures","Douleurs chroniques","Soin a distance sur photo"],"hasOccupation":{"@type":"Occupation","name":"Magnetiseur Guerisseur","occupationLocation":{"@type":"Country","name":"France"},"description":"Praticien en soins energetiques et magnetisme traditionnel"},"worksFor":{"@id":"https://www.jean-francois-magnetiseur-guerisseur.com/#business"},"telephone":"+33955554462","email":"guerisseurtoucheur@gmail.com","image":"https://www.jean-francois-magnetiseur-guerisseur.com/logo.png"},{"@type":"Service","@id":"https://www.jean-francois-magnetiseur-guerisseur.com/#service-magnetisme","name":"Soin energetique a distance sur photo","description":"Soin de magnetisme realise a distance grace a l'envoi d'une photo. Efficace pour zona, brulures, eczema, douleurs. Resultat souvent ressenti dans l'heure.","provider":{"@id":"https://www.jean-francois-magnetiseur-guerisseur.com/#business"},"areaServed":{"@type":"Country","name":"France"},"serviceType":"Magnetisme a distance","category":["Soin energetique","Medecine alternative","Bien-etre"],"hasOfferCatalog":{"@id":"https://www.jean-francois-magnetiseur-guerisseur.com/#business"},"termsOfService":"Paiement par PayPal avant le soin. Maximum 5 demandes traitees par jour."},{"@type":"Service","@id":"https://www.jean-francois-magnetiseur-guerisseur.com/#service-coupeur-feu","name":"Coupeur de feu - Soulagement des brulures","description":"Technique traditionnelle pour soulager instantanement la douleur des brulures. Reconnue dans certains services hospitaliers. Action a distance possible.","provider":{"@id":"https://www.jean-francois-magnetiseur-guerisseur.com/#business"},"areaServed":{"@type":"Country","name":"France"},"serviceType":"Coupeur de feu"},{"@type":"Service","@id":"https://www.jean-francois-magnetiseur-guerisseur.com/#service-zona","name":"Magnetisme contre le zona","description":"Traitement energetique du zona par magnetisme. Soulagement rapide des douleurs et acceleration de la guerison. Action a distance sur photo.","provider":{"@id":"https://www.jean-francois-magnetiseur-guerisseur.com/#business"},"areaServed":{"@type":"Country","name":"France"},"serviceType":"Traitement du zona"},{"@type":"MedicalCondition","@id":"https://www.jean-francois-magnetiseur-guerisseur.com/#condition-zona","name":"Zona","alternateName":"Herpes zoster","description":"Infection virale provoquant des eruptions cutanees douloureuses","possibleTreatment":{"@id":"https://www.jean-francois-magnetiseur-guerisseur.com/#service-zona"}},{"@type":"FAQPage","@id":"https://www.jean-francois-magnetiseur-guerisseur.com/#faq","name":"Questions frequentes sur le magnetisme et les soins a distance","mainEntity":[{"@type":"Question","name":"Comment fonctionne le soin a distance sur photo ?","acceptedAnswer":{"@type":"Answer","text":"Vous envoyez une photo recente de votre visage via le formulaire. Jean-Francois se connecte a votre energie et realise le soin. L'effet est souvent ressenti dans l'heure, quelle que soit la distance."}},{"@type":"Question","name":"Qu'est-ce qu'un coupeur de feu ?","acceptedAnswer":{"@type":"Answer","text":"Un coupeur de feu est un guerisseur capable de soulager instantanement la douleur des brulures par imposition des mains ou a distance. Jean-Francois pratique cette technique reconnue meme dans certains hopitaux."}},{"@type":"Question","name":"Le magnetisme peut-il soulager un zona ?","acceptedAnswer":{"@type":"Answer","text":"Oui, le magnetisme est particulierement efficace sur le zona. Jean-Francois traite de nombreux cas de zona a distance avec des resultats rapides sur la douleur et l'evolution des lesions."}},{"@type":"Question","name":"Combien coute un soin energetique a distance ?","acceptedAnswer":{"@type":"Answer","text":"Jean-Francois propose 3 formules : Soin Ponctuel a 35 euros (1 seance), Soin Complet a 55 euros (2 seances sur 48h, recommande), et Forfait Suivi a 120 euros (5 seances sur 2 semaines). Paiement securise par PayPal avant le soin."}},{"@type":"Question","name":"Comment contacter Jean-Francois ?","acceptedAnswer":{"@type":"Answer","text":"Vous pouvez appeler directement Jean-Francois au 09 55 55 44 62 ou remplir le formulaire de demande de soin sur le site. Il traite maximum 5 demandes par jour pour garantir la qualite de chaque soin."}}]},{"@type":"WebSite","@id":"https://www.jean-francois-magnetiseur-guerisseur.com/#website","url":"https://www.jean-francois-magnetiseur-guerisseur.com","name":"Jean-Francois Magnetiseur Guerisseur","description":"Site officiel du magnetiseur guerisseur Jean-Francois. Soins energetiques a distance sur photo partout en France.","publisher":{"@id":"https://www.jean-francois-magnetiseur-guerisseur.com/#business"},"inLanguage":"fr-FR","potentialAction":{"@type":"SearchAction","target":"https://www.jean-francois-magnetiseur-guerisseur.com/?q={search_term_string}","query-input":"required name=search_term_string"}},{"@type":"VideoObject","@id":"https://www.jean-francois-magnetiseur-guerisseur.com/#video","name":"Jean-Francois Magnetiseur Guerisseur - Presentation","description":"Decouvrez Jean-Francois, magnetiseur guerisseur specialise dans les soins energetiques a distance sur photo. Coupeur de feu, traitement du zona, eczema et douleurs chroniques partout en France.","thumbnailUrl":"https://www.jean-francois-magnetiseur-guerisseur.com/logo.png","uploadDate":"2024-01-01","contentUrl":"https://hebbkx1anhila5yf.public.blob.vercel-storage.com/jean-francois-magnetiseur-guerisseur_video-NLOPDOs77bOl491U2cfIJSUXAeijtj.MP4","embedUrl":"https://www.jean-francois-magnetiseur-guerisseur.com/presentation","duration":"PT30S","publisher":{"@id":"https://www.jean-francois-magnetiseur-guerisseur.com/#business"}},{"@type":"BreadcrumbList","@id":"https://www.jean-francois-magnetiseur-guerisseur.com/#breadcrumb","itemListElement":[{"@type":"ListItem","position":1,"name":"Accueil","item":"https://www.jean-francois-magnetiseur-guerisseur.com/"},{"@type":"ListItem","position":2,"name":"Demande de soin","item":"https://www.jean-francois-magnetiseur-guerisseur.com/demande-soin"},{"@type":"ListItem","position":3,"name":"Blog","item":"https://www.jean-francois-magnetiseur-guerisseur.com/blog"},{"@type":"ListItem","position":4,"name":"Questions","item":"https://www.jean-francois-magnetiseur-guerisseur.com/questions"}]}]}0:{"P":null,"b":"z3hE9rtzdPROPpTGVzXck","p":"","c":["","magnetiseur-montpellier"],"i":false,"f":[[["",{"children":["magnetiseur-montpellier",{"children":["__PAGE__",{}]}]},"$undefined","$undefined",true],["",["$","$1","c",{"children":[[["$","link","0",{"rel":"stylesheet","href":"/_next/static/css/74efe573cafa7900.css","precedence":"next","crossOrigin":"$undefined","nonce":"$undefined"}]],["$","html",null,{"lang":"fr","children":[["$","head",null,{"children":[["$","meta",null,{"name":"viewport","content":"width=device-width, initial-sca